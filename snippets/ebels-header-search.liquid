{% comment %}
  EBELS HEADER SEARCH
  Inline search bar for the desktop header (mobile keeps Dawn's search icon).
  Rendered from sections/header.liquid.
{% endcomment %}

<form action="{{ routes.search_url }}" method="get" role="search" class="ebels-header-search">
  <svg class="ebels-header-search__icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="8"></circle>
    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
  </svg>
  <input
    type="search"
    name="q"
    class="ebels-header-search__input"
    placeholder="Search our collection..."
    value="{{ search.terms | escape }}"
    aria-label="Search our collection"
  >
  <input type="hidden" name="options[prefix]" value="last">
</form>
