{% comment %}
  EBELS PROMO BANNER
  Dynamic, interchangeable promotional banners.
  Each banner block: desktop + mobile artwork, optional live text overlay,
  position/theme/overlay controls, optional slow Ken Burns zoom.
  Multiple blocks = auto-rotating carousel with dots.
{% endcomment %}

{% liquid
  case section.settings.height
    when 'compact'
      assign banner_height = 260
    when 'tall'
      assign banner_height = 420
    else
      assign banner_height = 320
  endcase
%}

<div
  class="ebels-promo"
  id="EbelsPromo-{{ section.id }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  style="--promo-height: {{ banner_height }}px;"
>
  <div class="ebels-promo__track">
    {% for block in section.blocks %}
      <div class="ebels-promo__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
        <div class="ebels-promo__media{% if block.settings.kenburns %} ebels-promo__media--kenburns{% endif %}">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 2880 | image_tag: loading: 'lazy', class: 'ebels-promo__img ebels-promo__img--desktop', widths: '1100, 1500, 2000, 2880' }}
          {% endif %}
          {% if block.settings.image_mobile != blank %}
            {{ block.settings.image_mobile | image_url: width: 1080 | image_tag: loading: 'lazy', class: 'ebels-promo__img ebels-promo__img--mobile', widths: '540, 750, 1080' }}
          {% endif %}
          {% if block.settings.image == blank and block.settings.image_mobile == blank %}
            <div class="ebels-promo__fallback"></div>
          {% endif %}
        </div>

        {% if block.settings.overlay > 0 %}
          <div class="ebels-promo__overlay" style="opacity: {{ block.settings.overlay | divided_by: 100.0 }};"></div>
        {% endif %}

        <div class="ebels-promo__content ebels-promo__content--{{ block.settings.content_position }} ebels-promo__content--{{ block.settings.text_theme }}">
          {% if block.settings.badge != blank %}
            <span class="ebels-promo__badge">{{ block.settings.badge }}</span>
          {% endif %}
          {% if block.settings.heading != blank %}
            <h2 class="ebels-promo__heading">{{ block.settings.heading }}</h2>
          {% endif %}
          {% if block.settings.text != blank %}
            <p class="ebels-promo__text">{{ block.settings.text }}</p>
          {% endif %}
          {% if block.settings.button_label != blank %}
            <a href="{{ block.settings.button_link | default: '#' }}" class="ebels-promo__btn ebels-promo__btn--{{ block.settings.button_style }}">
              {{ block.settings.button_label }}
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>

  {% if section.blocks.size > 1 %}
    <div class="ebels-promo__dots">
      {% for block in section.blocks %}
        <button
          class="ebels-promo__dot{% if forloop.first %} is-active{% endif %}"
          data-dot-index="{{ forloop.index0 }}"
          aria-label="Go to banner {{ forloop.index }}"
        ></button>
      {% endfor %}
    </div>
  {% endif %}
</div>

{% style %}
  .ebels-promo {
    max-width: 1440px;
    margin: var(--space-8) auto;
    padding: 0 var(--space-4);
  }

  .ebels-promo__track {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    min-height: var(--promo-height);
  }

  .ebels-promo__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.6s ease;
    pointer-events: none;
  }

  .ebels-promo__slide.is-active {
    position: relative;
    opacity: 1;
    pointer-events: auto;
  }

  .ebels-promo__media {
    position: absolute;
    inset: 0;
  }

  .ebels-promo__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ebels-promo__img--mobile { display: none; }

  .ebels-promo__fallback {
    position: absolute;
    inset: 0;
    background: var(--brand-gradient);
  }

  .ebels-promo__media--kenburns .ebels-promo__img {
    animation: ebels-kenburns 16s ease-in-out infinite alternate;
  }

  @keyframes ebels-kenburns {
    from { transform: scale(1); }
    to   { transform: scale(1.06); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ebels-promo__media--kenburns .ebels-promo__img { animation: none; }
  }

  .ebels-promo__overlay {
    position: absolute;
    inset: 0;
    background: var(--ebels-ink);
  }

  .ebels-promo__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-height: var(--promo-height);
    max-width: 520px;
    padding: var(--space-10) var(--space-12);
  }

  .ebels-promo__content--center {
    align-items: center;
    text-align: center;
    margin: 0 auto;
  }

  .ebels-promo__content--right {
    margin-left: auto;
    align-items: flex-start;
  }

  .ebels-promo__badge {
    font-family: var(--font-body);
    font-size: var(--text-caption-size);
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-4);
  }

  .ebels-promo__heading {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: var(--text-h2-size);
    line-height: var(--text-h2-line);
    letter-spacing: var(--text-h2-tracking);
    margin: 0 0 var(--space-3);
  }

  .ebels-promo__text {
    font-family: var(--font-body);
    font-size: var(--text-body-size);
    line-height: var(--text-body-line);
    margin: 0 0 var(--space-6);
  }

  /* Light text theme (dark artwork) */
  .ebels-promo__content--light { color: #FFFFFF; }
  .ebels-promo__content--light .ebels-promo__heading { color: #FFFFFF; }
  .ebels-promo__content--light .ebels-promo__text { color: rgba(255, 255, 255, 0.88); }
  .ebels-promo__content--light .ebels-promo__badge {
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  /* Dark text theme (light artwork) */
  .ebels-promo__content--dark { color: var(--text-primary); }
  .ebels-promo__content--dark .ebels-promo__heading { color: var(--text-primary); }
  .ebels-promo__content--dark .ebels-promo__text { color: var(--text-primary); opacity: 0.75; }
  .ebels-promo__content--dark .ebels-promo__badge {
    color: var(--text-primary);
    background: rgba(34, 27, 22, 0.08);
  }

  /* Button styles */
  .ebels-promo__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-size: var(--text-body-sm-size);
    font-weight: 600;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.1s ease;
  }

  .ebels-promo__btn:hover { opacity: 0.9; }
  .ebels-promo__btn:active { transform: scale(0.98); }

  .ebels-promo__btn--gradient { background: var(--brand-gradient); color: #FFFFFF; }
  .ebels-promo__btn--white { background: #FFFFFF; color: var(--text-primary); }
  .ebels-promo__btn--ink { background: var(--ebels-ink); color: #FFFFFF; }

  .ebels-promo__dots {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    padding-top: var(--space-4);
  }

  .ebels-promo__dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    border: none;
    background: var(--ebels-blush);
    cursor: pointer;
    padding: 0;
    transition: background 0.2s ease, width 0.2s ease;
  }

  .ebels-promo__dot.is-active {
    background: var(--ebels-flame);
    width: 20px;
  }

  @media screen and (max-width: 749px) {
    .ebels-promo__track { min-height: 420px; }
    .ebels-promo__content {
      min-height: 420px;
      max-width: 100%;
      padding: var(--space-8) var(--space-6);
      justify-content: flex-end;
    }
    .ebels-promo__img--mobile { display: block; }
    .ebels-promo__img--mobile ~ .ebels-promo__img--desktop,
    .ebels-promo__img--desktop:has(~ .ebels-promo__img--mobile) { display: none; }
  }
{% endstyle %}

<script>
  (function () {
    function initPromo(root) {
      var slides = root.querySelectorAll('.ebels-promo__slide');
      var dots = root.querySelectorAll('.ebels-promo__dot');
      if (slides.length < 2) return;

      var current = 0;
      var timer = null;
      var autoplay = root.dataset.autoplay === 'true';
      var speed = parseInt(root.dataset.speed, 10) || 7000;

      function goTo(index) {
        slides[current].classList.remove('is-active');
        if (dots[current]) dots[current].classList.remove('is-active');
        current = (index + slides.length) % slides.length;
        slides[current].classList.add('is-active');
        if (dots[current]) dots[current].classList.add('is-active');
      }

      function start() {
        if (!autoplay) return;
        stop();
        timer = setInterval(function () { goTo(current + 1); }, speed);
      }

      function stop() { if (timer) clearInterval(timer); }

      dots.forEach(function (dot) {
        dot.addEventListener('click', function () {
          goTo(parseInt(dot.dataset.dotIndex, 10));
          start();
        });
      });

      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);

      start();
    }

    document.querySelectorAll('.ebels-promo').forEach(initPromo);

    document.addEventListener('shopify:section:load', function (event) {
      var promo = event.target.querySelector('.ebels-promo');
      if (promo) initPromo(promo);
    });
  })();
</script>

{% schema %}
{
  "name": "Ebels Promo Banner",
  "tag": "section",
  "class": "section-ebels-promo",
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "Banner height (desktop)",
      "options": [
        { "value": "compact", "label": "Compact (260px)" },
        { "value": "standard", "label": "Standard (320px)" },
        { "value": "tall", "label": "Tall (420px)" }
      ],
      "default": "standard"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate banners",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Seconds per banner",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 7
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Artwork — desktop",
          "info": "2880 × 640px (standard) or 2880 × 840px (tall)"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Artwork — mobile (optional)",
          "info": "1080 × 1170px. Desktop artwork is used if empty."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "info": "Leave text fields empty if your artwork has copy baked in"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content position",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "select",
          "id": "text_theme",
          "label": "Text color",
          "options": [
            { "value": "light", "label": "Light (for dark artwork)" },
            { "value": "dark", "label": "Dark (for light artwork)" }
          ],
          "default": "light"
        },
        {
          "type": "range",
          "id": "overlay",
          "label": "Darkening overlay",
          "min": 0,
          "max": 60,
          "step": 5,
          "default": 0,
          "info": "Adds contrast when text sits on busy artwork"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            { "value": "gradient", "label": "Brand gradient" },
            { "value": "white", "label": "White" },
            { "value": "ink", "label": "Ink (dark)" }
          ],
          "default": "white"
        },
        {
          "type": "checkbox",
          "id": "kenburns",
          "label": "Slow zoom effect on artwork",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Ebels Promo Banner",
      "blocks": [
        { "type": "banner" }
      ]
    }
  ]
}
{% endschema %}
