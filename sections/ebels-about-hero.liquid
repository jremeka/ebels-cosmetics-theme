{{ 'ebels-about-hero.css' | asset_url | stylesheet_tag }}

<div class="ebels-about-hero page-width">
  {%- render 'ebels-breadcrumb', override_current: 'About' -%}

  <div
    class="ebels-about-hero__banner"
    data-reveal
    {%- if section.settings.image %}
      style="--ebels-hero-bg: url('{{ section.settings.image | image_url: width: 1600 }}');"
    {%- endif %}
  >
    {%- if section.settings.overlay > 0 -%}
      <div class="ebels-about-hero__overlay" style="opacity: {{ section.settings.overlay | divided_by: 100.0 }};"></div>
    {%- endif -%}
    <div class="ebels-about-hero__content ebels-about-hero__content--{{ section.settings.text_theme }}">
      <h1 class="ebels-about-hero__title">{{ section.settings.title }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="ebels-about-hero__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Ebels About Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "title", "label": "Title", "default": "Our Story" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Where luxury meets self-expression" },
    {
      "type": "select",
      "id": "text_theme",
      "label": "Text color",
      "options": [
        { "value": "light", "label": "Light (for dark artwork)" },
        { "value": "dark", "label": "Dark (for light artwork)" }
      ],
      "default": "light"
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Darkening overlay",
      "min": 0,
      "max": 60,
      "step": 5,
      "default": 35,
      "info": "Adds contrast when text sits on busy artwork. Set to 0 if using dark text on a light image."
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 32 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 32 }
  ],
  "presets": [{ "name": "Ebels About Hero" }]
}
{% endschema %}
