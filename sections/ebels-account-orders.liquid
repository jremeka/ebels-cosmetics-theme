{{ 'ebels-account-orders.css' | asset_url | stylesheet_tag }}

{%- if customer or request.design_mode -%}
<div class="ebels-acc-ord page-width" data-account-tab-panel="orders" hidden>
  <script type="application/json" data-money-format>{{ shop.money_format | json }}</script>

  {%- if customer.orders.size > 0 -%}
    <div class="ebels-acc-ord__meta">
      <p class="ebels-acc-ord__count">{{ customer.orders_count }} order{% if customer.orders_count != 1 %}s{% endif %}</p>
    </div>

    <div class="ebels-acc-ord__list">
      {%- for order in customer.orders -%}
        <div class="ebels-acc-ord__card">
          <div class="ebels-acc-ord__card-head">
            <div>
              <p class="ebels-acc-ord__number">Order #{{ order.name }}</p>
              <p class="ebels-caption">{{ order.created_at | date: '%d %b %Y' }}</p>
            </div>

            {%- if order.fulfillment_status == 'fulfilled' -%}
              <span class="ebels-acc-ord__status ebels-acc-ord__status--delivered">● Delivered</span>
            {%- elsif order.fulfillment_status == 'partial' -%}
              <span class="ebels-acc-ord__status ebels-acc-ord__status--transit">● In Transit</span>
            {%- else -%}
              <span class="ebels-acc-ord__status ebels-acc-ord__status--processing">● Processing</span>
            {%- endif -%}
          </div>

          <div class="ebels-acc-ord__items">
            {%- for line_item in order.line_items -%}
              <div class="ebels-acc-ord__item">
                <div class="ebels-acc-ord__item-media">
                  {%- if line_item.image -%}
                    <img src="{{ line_item.image | image_url: width: 150 }}" alt="{{ line_item.title | escape }}" loading="lazy" width="75" height="75">
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'ebels-acc-ord__item-placeholder' }}
                  {%- endif -%}
                </div>
                <div>
                  <p class="ebels-acc-ord__item-title">{{ line_item.title }}</p>
                  <p class="ebels-caption">Qty: {{ line_item.quantity }}</p>
                  {%- if line_item.product.url != blank -%}
                    <a href="{{ line_item.product.url }}#judgeme_product_reviews" class="ebels-acc-ord__item-review-link">Write a Review</a>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}

            <div class="ebels-acc-ord__total">
              <p class="ebels-caption">Order Total</p>
              <p class="ebels-acc-ord__total-value">{{ order.total_price | money }}</p>
            </div>
          </div>

          <div class="ebels-acc-ord__actions">
            <button type="button" class="ebels-acc-ord__link" data-order-details-toggle aria-expanded="false" aria-controls="OrderDetail-{{ order.id }}">
              View Details
            </button>
            {%- assign tracking_url = '' -%}
            {%- for fulfillment in order.fulfillments -%}
              {%- if fulfillment.tracking_url != blank -%}
                {%- assign tracking_url = fulfillment.tracking_url -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if tracking_url != '' -%}
              <a href="{{ tracking_url }}" class="ebels-acc-ord__link ebels-acc-ord__link--brand" target="_blank" rel="noopener">Track Package</a>
            {%- endif -%}

            <div class="ebels-acc-ord__actions-right">
              <button type="button" class="ebels-btn ebels-btn--outline ebels-acc-ord__reorder" data-account-reorder data-order-id="{{ order.id }}">
                Reorder
              </button>
            </div>
          </div>

          {%- comment -%} Inline order detail panel — hidden by default, toggled open by data-order-details-toggle above {%- endcomment -%}
          <div id="OrderDetail-{{ order.id }}" class="ebels-acc-ord__detail" data-order-detail hidden>

            <div class="ebels-acc-ord__detail-timeline">
              <div class="ebels-acc-ord__detail-timeline-step is-complete">
                <span class="ebels-acc-ord__detail-timeline-dot">✓</span>
                <div>
                  <p class="ebels-acc-ord__detail-timeline-label">Confirmed</p>
                  <p class="ebels-caption">{{ order.created_at | date: '%d %b %Y' }}</p>
                </div>
              </div>
              <div class="ebels-acc-ord__detail-timeline-step{% if order.fulfillment_status == 'fulfilled' or order.fulfillment_status == 'partial' %} is-complete{% endif %}">
                <span class="ebels-acc-ord__detail-timeline-dot">{% if order.fulfillment_status == 'fulfilled' or order.fulfillment_status == 'partial' %}✓{% else %}○{% endif %}</span>
                <div>
                  <p class="ebels-acc-ord__detail-timeline-label">Shipped</p>
                </div>
              </div>
              <div class="ebels-acc-ord__detail-timeline-step{% if order.fulfillment_status == 'fulfilled' %} is-complete{% endif %}">
                <span class="ebels-acc-ord__detail-timeline-dot">{% if order.fulfillment_status == 'fulfilled' %}✓{% else %}○{% endif %}</span>
                <div>
                  <p class="ebels-acc-ord__detail-timeline-label">Delivered</p>
                </div>
              </div>
            </div>

            <div class="ebels-acc-ord__detail-section">
              <h3 class="ebels-acc-ord__detail-heading">Items</h3>
              {%- for line_item in order.line_items -%}
                <div class="ebels-acc-ord__detail-line">
                  <span>{{ line_item.title }} × {{ line_item.quantity }}</span>
                  <span>{{ line_item.final_line_price | money }}</span>
                </div>
              {%- endfor -%}
            </div>

            <div class="ebels-acc-ord__detail-section">
              <div class="ebels-acc-ord__detail-line">
                <span class="ebels-caption">Subtotal</span>
                <span>{{ order.subtotal_price | money }}</span>
              </div>
              <div class="ebels-acc-ord__detail-line">
                <span class="ebels-caption">Shipping</span>
                <span>
                  {%- assign shipping_line = order.shipping_methods.first -%}
                  {%- if shipping_line and shipping_line.price > 0 -%}
                    {{ shipping_line.price | money }}
                  {%- else -%}
                    Free
                  {%- endif -%}
                </span>
              </div>
              {%- if order.total_tax > 0 -%}
                <div class="ebels-acc-ord__detail-line">
                  <span class="ebels-caption">Tax</span>
                  <span>{{ order.total_tax | money }}</span>
                </div>
              {%- endif -%}
              <div class="ebels-acc-ord__detail-line ebels-acc-ord__detail-line--total">
                <span>Total</span>
                <span>{{ order.total_price | money }}</span>
              </div>
            </div>

            <div class="ebels-acc-ord__detail-section">
              <h3 class="ebels-acc-ord__detail-heading">Contact</h3>
              <p class="ebels-body-sm">{{ order.email }}</p>
            </div>

            {%- if order.billing_address -%}
              <div class="ebels-acc-ord__detail-section">
                <h3 class="ebels-acc-ord__detail-heading">Billing address</h3>
                <p class="ebels-body-sm">
                  {{ order.billing_address.name }}<br>
                  {%- if order.billing_address.address1 != blank -%}{{ order.billing_address.address1 }}<br>{%- endif -%}
                  {%- if order.billing_address.address2 != blank -%}{{ order.billing_address.address2 }}<br>{%- endif -%}
                  {{ order.billing_address.city }}{% if order.billing_address.province_code != blank %}, {{ order.billing_address.province_code }}{% endif %} {{ order.billing_address.zip }}<br>
                  {{ order.billing_address.country }}
                  {%- if order.billing_address.phone != blank -%}<br>{{ order.billing_address.phone }}{%- endif -%}
                </p>
              </div>
            {%- endif -%}

            <div class="ebels-acc-ord__detail-section">
              <h3 class="ebels-acc-ord__detail-heading">Payment</h3>
              <p class="ebels-body-sm">{{ order.financial_status | capitalize }} · {{ order.total_price | money }}</p>
            </div>
          </div>

          {%- comment -%} Hidden data for the Reorder button's JS to read variant IDs/quantities {%- endcomment -%}
          <script type="application/json" data-order-lines="{{ order.id }}">
            [
              {%- for line_item in order.line_items -%}
                { "variant_id": {{ line_item.variant_id | json }}, "quantity": {{ line_item.quantity | json }} }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]
          </script>
        </div>
      {%- endfor -%}
    </div>

    {%- comment -%}
      RE-ORDER YOUR FAVOURITES — genuinely pulled from real past-purchased
      products (unique, most recent first), not hand-picked or algorithmic.
    {%- endcomment -%}
    {%- assign seen_handles = '' -%}
    <div class="ebels-acc-ord__favourites">
      <h2 class="ebels-acc-ord__favourites-title">Re-order your favourites</h2>
      <div class="ebels-acc-ord__favourites-grid">
        {%- assign seen_handles_array = seen_handles | split: ',' -%}
        {%- for order in customer.orders -%}
          {%- for line_item in order.line_items -%}
            {%- assign handle = line_item.product.handle -%}
            {%- unless seen_handles_array contains handle -%}
              {%- assign seen_handles = seen_handles | append: handle | append: ',' -%}
              {%- assign seen_handles_array = seen_handles | split: ',' -%}
              {%- assign fav_variant = line_item.product.selected_or_first_available_variant -%}
              <div class="ebels-acc-ord__fav-card">
                <a href="{{ line_item.product.url }}" class="ebels-acc-ord__fav-media-link">
                  <div class="ebels-acc-ord__fav-media">
                    {%- if line_item.product.tags contains 'Coming Soon' -%}
                      <span class="ebels-acc-ord__fav-badge">Coming Soon</span>
                    {%- endif -%}
                    {%- if line_item.image -%}
                      <img
                        src="{{ line_item.image | image_url: width: 400 }}"
                        alt="{{ line_item.title | escape }}"
                        loading="lazy"
                        width="400"
                        height="{{ 400 | divided_by: line_item.image.aspect_ratio }}"
                      >
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'ebels-acc-ord__fav-img' }}
                    {%- endif -%}
                  </div>
                </a>
                <p class="ebels-acc-ord__fav-title">{{ line_item.title }}</p>
                <p class="ebels-acc-ord__fav-price">{{ fav_variant.price | money }}</p>
                <button
                  type="button"
                  class="ebels-btn ebels-acc-ord__fav-add"
                  data-add-to-bag-fav
                  data-variant-id="{{ fav_variant.id }}"
                  {% unless fav_variant.available %}disabled{% endunless %}
                >
                  {%- if fav_variant.available -%}Add to Bag{%- elsif line_item.product.tags contains 'Coming Soon' -%}Coming Soon{%- else -%}Sold Out{%- endif -%}
                </button>
              </div>
            {%- endunless -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- else -%}
    <div class="ebels-acc-ord__empty">
      <p class="ebels-body">You haven't placed any orders yet.</p>
      <a href="{{ routes.all_products_collection_url }}" class="ebels-btn ebels-acc-ord__empty-cta">Start Shopping</a>
    </div>
  {%- endif -%}
</div>
{%- endif -%}

<script src="{{ 'ebels-account-orders.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Ebels Account Orders",
  "settings": [],
  "presets": [
    { "name": "Ebels Account Orders" }
  ]
}
{% endschema %}
