{{ 'ebels-password-hero.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  EBELS PASSWORD HERO
  Replaces Dawn's default "email-signup-banner" as the main content of
  templates/password.json. Uses Shopify's real {% form 'customer' %}
  mechanism for the "Notify Me" signup — same real, working pattern used
  on Contact Us — tagged so subscribers are identifiable in Customers.
{%- endcomment -%}

<div class="ebels-password-hero">
  <div class="ebels-password-hero__media">
    {%- if section.settings.image -%}
      <img
  src="{{ section.settings.image | image_url: width: 1400 }}"
  alt=""
  loading="eager"
  width="1400"
  height="{{ 1400 | divided_by: section.settings.image.aspect_ratio }}"
>
    {%- endif -%}
  </div>

  <div class="ebels-password-hero__content">
    <h1 class="ebels-password-hero__title">{{ section.settings.title }}</h1>
    {%- if section.settings.subtitle != blank -%}
      <p class="ebels-password-hero__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'ebels-password-hero__form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password_page">
      {%- if form.posted_successfully? -%}
        <p class="ebels-password-hero__success">Thanks — we'll let you know the moment we launch.</p>
      {%- else -%}
        {%- if form.errors -%}
          <p class="ebels-password-hero__error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="ebels-password-hero__field-row">
          <input
            type="email"
            name="contact[email]"
            placeholder="Enter your email address"
            aria-label="Email address"
            required
          >
          <button type="submit" class="ebels-btn ebels-password-hero__submit">Notify Me</button>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Ebels Password Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "title", "label": "Title", "default": "Opening Soon" },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Something beautiful is brewing. We are crafting a more luxurious shopping experience just for you. Be the first to know when we launch."
    }
  ],
  "presets": [{ "name": "Ebels Password Hero" }]
}
{% endschema %}
