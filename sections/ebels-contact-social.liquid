{{ 'ebels-contact-social.css' | asset_url | stylesheet_tag }}

<div class="ebels-contact-social page-width">
  {%- if section.settings.title != blank -%}
    <h2 class="ebels-contact-social__title" data-reveal>{{ section.settings.title }}</h2>
  {%- endif -%}
  {%- if section.settings.subtitle != blank -%}
    <p class="ebels-contact-social__subtitle" data-reveal>{{ section.settings.subtitle }}</p>
  {%- endif -%}

  <div class="ebels-contact-social__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.url }}" class="ebels-contact-social__item" data-reveal {{ block.shopify_attributes }}>
        <span class="ebels-contact-social__icon" aria-hidden="true">{{ block.settings.icon }}</span>
        <span class="ebels-contact-social__platform">{{ block.settings.platform }}</span>
        <span class="ebels-contact-social__handle">{{ block.settings.handle }}</span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Ebels Contact Social",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Follow Us" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Stay connected for beauty tips, new launches, and exclusive offers" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 60, "step": 4, "unit": "px", "label": "Padding top", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 60, "step": 4, "unit": "px", "label": "Padding bottom", "default": 24 }
  ],
  "blocks": [
    {
      "type": "channel",
      "name": "Channel",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji or symbol)", "default": "\u25CE" },
        { "type": "text", "id": "platform", "label": "Platform", "default": "Instagram" },
        { "type": "text", "id": "handle", "label": "Handle", "default": "@ebelscosmetics" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ebels Contact Social",
      "blocks": [
        { "type": "channel" },
        { "type": "channel" },
        { "type": "channel" }
      ]
    }
  ]
}
{% endschema %}
