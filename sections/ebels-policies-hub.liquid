{{ 'ebels-policies-hub.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  EBELS POLICIES HUB
  Privacy/Shipping/Return/Terms pull REAL content from shop.*_policy
  objects (Admin > Settings > Policies) via JS tab-switching, no page
  reload. Accessibility Statement and Cookie Policy aren't native Shopify
  policy types, so they link out to separate custom Pages instead
  (create these as regular Pages, same pattern as About/FAQ).
{%- endcomment -%}

<div class="ebels-policies page-width">
  {%- render 'ebels-breadcrumb', override_current: 'Policies' -%}

  <div class="ebels-policies__intro" data-reveal>
    <h1 class="ebels-policies__title">{{ section.settings.title }}</h1>
    {%- if section.settings.subtitle != blank -%}
      <p class="ebels-policies__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
  </div>

  <div class="ebels-policies__layout">
    <nav class="ebels-policies__nav" aria-label="Policies">
      {%- if shop.privacy_policy.body != blank -%}
        <button type="button" class="ebels-policies__nav-item is-active" data-policy-tab="privacy">
          Privacy Policy
        </button>
      {%- endif -%}
      {%- if shop.shipping_policy.body != blank -%}
        <button type="button" class="ebels-policies__nav-item" data-policy-tab="shipping">
          Shipping Policy
        </button>
      {%- endif -%}
      {%- if shop.refund_policy.body != blank -%}
        <button type="button" class="ebels-policies__nav-item" data-policy-tab="refund">
          Return &amp; Refund Policy
        </button>
      {%- endif -%}
      {%- if shop.terms_of_service.body != blank -%}
        <button type="button" class="ebels-policies__nav-item" data-policy-tab="terms">
          Terms of Service
        </button>
      {%- endif -%}
      {%- if section.settings.accessibility_page != blank -%}
        <a href="{{ section.settings.accessibility_page.url }}" class="ebels-policies__nav-item ebels-policies__nav-item--link">
          Accessibility Statement
        </a>
      {%- endif -%}
      {%- if section.settings.cookie_page != blank -%}
        <a href="{{ section.settings.cookie_page.url }}" class="ebels-policies__nav-item ebels-policies__nav-item--link">
          Cookie Policy
        </a>
      {%- endif -%}
    </nav>

    <div class="ebels-policies__content">
      {%- if shop.privacy_policy.body != blank -%}
        <div class="ebels-policies__panel is-active" data-policy-panel="privacy">
          <h2>{{ shop.privacy_policy.title }}</h2>
          <p class="ebels-policies__updated">Last updated: {{ shop.privacy_policy.updated_at | date: '%B %d, %Y' }}</p>
          <div class="ebels-policies__body">{{ shop.privacy_policy.body }}</div>
        </div>
      {%- endif -%}
      {%- if shop.shipping_policy.body != blank -%}
        <div class="ebels-policies__panel" data-policy-panel="shipping">
          <h2>{{ shop.shipping_policy.title }}</h2>
          <p class="ebels-policies__updated">Last updated: {{ shop.shipping_policy.updated_at | date: '%B %d, %Y' }}</p>
          <div class="ebels-policies__body">{{ shop.shipping_policy.body }}</div>
        </div>
      {%- endif -%}
      {%- if shop.refund_policy.body != blank -%}
        <div class="ebels-policies__panel" data-policy-panel="refund">
          <h2>{{ shop.refund_policy.title }}</h2>
          <p class="ebels-policies__updated">Last updated: {{ shop.refund_policy.updated_at | date: '%B %d, %Y' }}</p>
          <div class="ebels-policies__body">{{ shop.refund_policy.body }}</div>
        </div>
      {%- endif -%}
      {%- if shop.terms_of_service.body != blank -%}
        <div class="ebels-policies__panel" data-policy-panel="terms">
          <h2>{{ shop.terms_of_service.title }}</h2>
          <p class="ebels-policies__updated">Last updated: {{ shop.terms_of_service.updated_at | date: '%B %d, %Y' }}</p>
          <div class="ebels-policies__body">{{ shop.terms_of_service.body }}</div>
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="ebels-policies__cta" data-reveal>
    <div>
      <h3>{{ section.settings.cta_title }}</h3>
      <p>{{ section.settings.cta_subtitle }}</p>
    </div>
    <a href="{{ section.settings.cta_link }}" class="ebels-btn ebels-btn--secondary">
      {{ section.settings.cta_button_label }}
    </a>
  </div>
</div>

<script src="{{ 'ebels-policies-hub.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Ebels Policies Hub",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Our Policies" },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "We believe in complete transparency, exceptional service, and mutual trust. Explore our store protocols and customer safeguards below."
    },
    { "type": "header", "content": "Non-native policy links" },
    {
      "type": "page",
      "id": "accessibility_page",
      "label": "Accessibility Statement page",
      "info": "Create this as a regular Page first, same as About/FAQ — not a native Shopify policy type"
    },
    {
      "type": "page",
      "id": "cookie_page",
      "label": "Cookie Policy page",
      "info": "Create this as a regular Page first, same as About/FAQ — not a native Shopify policy type"
    },
    { "type": "header", "content": "Bottom CTA" },
    { "type": "text", "id": "cta_title", "label": "CTA title", "default": "Still have questions about our terms?" },
    { "type": "text", "id": "cta_subtitle", "label": "CTA subtitle", "default": "Our dedicated concierge team is available 24/7 to clarify any legal or shipping questions you might have." },
    { "type": "text", "id": "cta_button_label", "label": "CTA button label", "default": "Contact Team" },
    { "type": "url", "id": "cta_link", "label": "CTA button link" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 60 }
  ],
  "presets": [{ "name": "Ebels Policies Hub" }]
}
{% endschema %}
