{{ 'ebels-account-profile.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  EBELS ACCOUNT PROFILE — v2
  Idle-card + edit-modal pattern instead of always-open forms. Beauty
  Profile fields removed. Real mechanisms only: profile info via
  {% form 'customer' %} fetch()-submitted in a modal; marketing consent
  via its own instant-save toggle; addresses via existing working
  {% form 'customer_address' %} + fetch() modal system.
{%- endcomment -%}

{%- if customer or request.design_mode -%}
<div class="ebels-acc-prof page-width" data-account-tab-panel="profile">

  <div class="ebels-acc-card">
    <div class="ebels-acc-card__header">
      <h2 class="ebels-acc-card__title">{{ customer.name | default: 'My Profile' }}</h2>
      <button type="button" class="ebels-acc-card__edit" data-modal-open="profile-info-modal">Edit</button>
    </div>
    <div class="ebels-acc-field-row">
      <span class="ebels-acc-field-row__label">Email</span>
      <span class="ebels-acc-field-row__value">{{ customer.email }}</span>
    </div>
  </div>

  <div class="ebels-acc-card">
    <div class="ebels-acc-card__header">
      <h2 class="ebels-acc-card__title">Addresses</h2>
      <button type="button" class="ebels-acc-card__edit" data-modal-open="address-new">+ Add</button>
    </div>

    {%- if customer.addresses.size > 0 -%}
      <div class="ebels-acc-addresses">
        {%- for address in customer.addresses -%}
          <div class="ebels-acc-address-item">
            <span class="ebels-acc-address-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s-7-6.4-7-11a7 7 0 0 1 14 0c0 4.6-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            </span>
            <div class="ebels-acc-address-item__body">
              <p class="ebels-acc-address-item__name">
                {{ address.first_name }} {{ address.last_name }}
                {%- if address == customer.default_address %}<span class="ebels-acc-tag">Default</span>{% endif -%}
              </p>
              <p class="ebels-acc-address-item__detail">
                {{ address.address1 }}{% if address.address2 != blank %}, {{ address.address2 }}{% endif %},
                {{ address.city }}, {{ address.province_code }} {{ address.zip }}, {{ address.country }}
              </p>
            </div>
            <div class="ebels-acc-address-item__actions">
              <button type="button" class="ebels-acc-address-item__edit-link" data-modal-open="address-{{ address.id }}">Edit</button>
              {%- form 'customer_address', address, class: 'ebels-acc-address-item__remove-form' -%}
                <input type="hidden" name="_method" value="delete">
                <button type="submit" class="ebels-acc-address-item__remove-link">Remove</button>
              {%- endform -%}
            </div>
          </div>

          <div class="ebels-acc-modal" data-modal="address-{{ address.id }}" hidden>
            <div class="ebels-acc-modal__overlay" data-modal-close></div>
            <div class="ebels-acc-modal__panel" role="dialog" aria-modal="true" aria-label="Edit address">
              <div class="ebels-acc-modal__head">
                <h3>Edit Address</h3>
                <button type="button" data-modal-close aria-label="Close">×</button>
              </div>
              {%- form 'customer_address', address, class: 'ebels-acc-modal__form' -%}
                <div class="ebels-acc-field-grid">
                  <div class="ebels-acc-field">
                    <label for="AddressFirstName{{ address.id }}">First Name</label>
                    <input type="text" id="AddressFirstName{{ address.id }}" name="address[first_name]" value="{{ address.first_name }}" required>
                  </div>
                  <div class="ebels-acc-field">
                    <label for="AddressLastName{{ address.id }}">Last Name</label>
                    <input type="text" id="AddressLastName{{ address.id }}" name="address[last_name]" value="{{ address.last_name }}" required>
                  </div>
                </div>
                <div class="ebels-acc-field">
                  <label for="Address1_{{ address.id }}">Address</label>
                  <input type="text" id="Address1_{{ address.id }}" name="address[address1]" value="{{ address.address1 }}" required>
                </div>
                <div class="ebels-acc-field">
                  <label for="Address2_{{ address.id }}">Apartment, suite, etc (optional)</label>
                  <input type="text" id="Address2_{{ address.id }}" name="address[address2]" value="{{ address.address2 }}">
                </div>
                <div class="ebels-acc-field-grid ebels-acc-field-grid--three">
                  <div class="ebels-acc-field">
                    <label for="City_{{ address.id }}">City</label>
                    <input type="text" id="City_{{ address.id }}" name="address[city]" value="{{ address.city }}" required>
                  </div>
                  <div class="ebels-acc-field">
                    <label for="Province_{{ address.id }}">State</label>
                    <input type="text" id="Province_{{ address.id }}" name="address[province]" value="{{ address.province }}" required>
                  </div>
                  <div class="ebels-acc-field">
                    <label for="Zip_{{ address.id }}">ZIP Code</label>
                    <input type="text" id="Zip_{{ address.id }}" name="address[zip]" value="{{ address.zip }}" required>
                  </div>
                </div>
                <input type="hidden" name="address[country]" value="United States">
                <div class="ebels-acc-field">
                  <label for="Phone_{{ address.id }}">Phone</label>
                  <input type="tel" id="Phone_{{ address.id }}" name="address[phone]" value="{{ address.phone }}">
                </div>
                <label class="ebels-acc-checkbox">
                  <input type="radio" name="address[default]" value="1" {% if address == customer.default_address %}checked{% endif %}>
                  <span>Set as default address</span>
                </label>
                <div class="ebels-acc-modal__actions">
                  <button type="button" class="ebels-btn ebels-btn--outline" data-modal-close>Cancel</button>
                  <button type="submit" class="ebels-btn ebels-acc-modal__save">Save</button>
                </div>
              {%- endform -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="ebels-acc-empty-note">You haven't added any addresses yet</p>
    {%- endif -%}
  </div>

  <div class="ebels-acc-card">
    <div class="ebels-acc-card__header">
      <h2 class="ebels-acc-card__title">Marketing Preferences</h2>
    </div>
    {%- form 'customer', class: 'ebels-acc-toggle-form' -%}
      <div class="ebels-acc-toggle-row">
        <span class="ebels-acc-toggle-row__label">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
          Email me about new drops, offers, and beauty tips
        </span>
        <label class="ebels-acc-switch">
          <input
            type="checkbox"
            name="customer[accepts_marketing]"
            value="1"
            data-marketing-toggle
            {% if customer.accepts_marketing %}checked{% endif %}
          >
          <span class="ebels-acc-switch__track">
  <span class="ebels-acc-switch__thumb">
    <svg class="ebels-acc-switch__check" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M2.5 6.5 4.5 8.5 9.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </span>
</span>
        </label>
      </div>
    {%- endform -%}
  </div>

  <a href="{{ routes.account_logout_url }}?return_url={{ shop.url | append: '/pages/my-account' | url_encode }}" class="ebels-acc-prof__logout">
    Sign Out
  </a>
</div>

<div class="ebels-acc-modal" data-modal="profile-info-modal" hidden>
  <div class="ebels-acc-modal__overlay" data-modal-close></div>
  <div class="ebels-acc-modal__panel" role="dialog" aria-modal="true" aria-label="Edit profile">
    <div class="ebels-acc-modal__head">
      <h3>Edit Profile</h3>
      <button type="button" data-modal-close aria-label="Close">×</button>
    </div>
    {%- form 'customer', class: 'ebels-acc-modal__form' -%}
      {%- if form.errors -%}
        <div class="ebels-acc-modal__error">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="ebels-acc-field-grid">
        <div class="ebels-acc-field">
          <label for="ProfileFirstName">First name</label>
          <input type="text" id="ProfileFirstName" name="customer[first_name]" value="{{ customer.first_name }}" required>
        </div>
        <div class="ebels-acc-field">
          <label for="ProfileLastName">Last name</label>
          <input type="text" id="ProfileLastName" name="customer[last_name]" value="{{ customer.last_name }}" required>
        </div>
      </div>
      <div class="ebels-acc-field">
        <label for="ProfileEmail">Email</label>
        <input type="email" id="ProfileEmail" name="customer[email]" value="{{ customer.email }}" required>
        <p class="ebels-acc-field__hint">This email is used for sign-in and order updates.</p>
      </div>
      <div class="ebels-acc-modal__actions">
        <button type="button" class="ebels-btn ebels-btn--outline" data-modal-close>Cancel</button>
        <button type="submit" class="ebels-btn ebels-acc-modal__save">Save</button>
      </div>
    {%- endform -%}
  </div>
</div>

<div class="ebels-acc-modal" data-modal="address-new" hidden>
  <div class="ebels-acc-modal__overlay" data-modal-close></div>
  <div class="ebels-acc-modal__panel" role="dialog" aria-modal="true" aria-label="Add new address">
    <div class="ebels-acc-modal__head">
      <h3>Add Address</h3>
      <button type="button" data-modal-close aria-label="Close">×</button>
    </div>
    {%- form 'customer_address', customer.new_address, class: 'ebels-acc-modal__form' -%}
      <div class="ebels-acc-field-grid">
        <div class="ebels-acc-field">
          <label for="AddressFirstNameNew">First Name</label>
          <input type="text" id="AddressFirstNameNew" name="address[first_name]" required>
        </div>
        <div class="ebels-acc-field">
          <label for="AddressLastNameNew">Last Name</label>
          <input type="text" id="AddressLastNameNew" name="address[last_name]" required>
        </div>
      </div>
      <div class="ebels-acc-field">
        <label for="Address1New">Address</label>
        <input type="text" id="Address1New" name="address[address1]" required>
      </div>
      <div class="ebels-acc-field">
        <label for="Address2New">Apartment, suite, etc (optional)</label>
        <input type="text" id="Address2New" name="address[address2]">
      </div>
      <div class="ebels-acc-field-grid ebels-acc-field-grid--three">
        <div class="ebels-acc-field">
          <label for="CityNew">City</label>
          <input type="text" id="CityNew" name="address[city]" required>
        </div>
        <div class="ebels-acc-field">
          <label for="ProvinceNew">State</label>
          <input type="text" id="ProvinceNew" name="address[province]" required>
        </div>
        <div class="ebels-acc-field">
          <label for="ZipNew">ZIP Code</label>
          <input type="text" id="ZipNew" name="address[zip]" required>
        </div>
      </div>
      <input type="hidden" name="address[country]" value="United States">
      <div class="ebels-acc-field">
        <label for="PhoneNew">Phone</label>
        <input type="tel" id="PhoneNew" name="address[phone]">
      </div>
      <label class="ebels-acc-checkbox">
        <input type="radio" name="address[default]" value="1" {% if customer.addresses.size == 0 %}checked{% endif %}>
        <span>Set as default address</span>
      </label>
      <div class="ebels-acc-modal__actions">
        <button type="button" class="ebels-btn ebels-btn--outline" data-modal-close>Cancel</button>
        <button type="submit" class="ebels-btn ebels-acc-modal__save">Save</button>
      </div>
    {%- endform -%}
  </div>
</div>
{%- endif -%}

<script src="{{ 'ebels-account-profile.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Ebels Account Profile",
  "settings": [],
  "presets": [
    { "name": "Ebels Account Profile" }
  ]
}
{% endschema %}
