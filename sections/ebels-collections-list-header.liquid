{{ 'ebels-collections-list-header.css' | asset_url | stylesheet_tag }}

<div class="ebels-clh page-width" data-reveal>
  {% render 'ebels-breadcrumb' %}

  <h1 class="ebels-clh__title">{{ section.settings.heading }}</h1>
  {%- if section.settings.subheading != blank -%}
    <p class="ebels-clh__subheading">{{ section.settings.subheading }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Ebels Collections Header",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Collections"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore our curated range of luxury beauty essentials"
    }
  ],
  "presets": [
    { "name": "Ebels Collections Header" }
  ]
}
{% endschema %}
