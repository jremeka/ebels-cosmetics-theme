{{ 'ebels-real-looks.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  EBELS REAL PEOPLE, REAL LOOKS
  Now pulls real, per-product UGC posts from a metaobject-referencing
  metafield instead of the same 3 hardcoded images on every product.
  Metafields required (see Metafield Setup Guide):
    custom.real_looks_posts    — List of metaobjects (Real Look Post)
    custom.real_looks_hashtag  — Single line text
  Section hides entirely if the product has no posts set — correct for
  products with no UGC yet, rather than showing generic/wrong content.
{%- endcomment -%}

{%- assign real_looks_posts = product.metafields.custom.real_looks_posts.value -%}

{%- if real_looks_posts != blank and real_looks_posts.size > 0 -%}
  <div class="ebels-rl page-width">
    <div class="ebels-rl__header" data-reveal>
      {%- if section.settings.heading != blank -%}
        <h2 class="ebels-rl__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="ebels-rl__subheading">
          {{ section.settings.subheading }}
          {%- if product.metafields.custom.real_looks_hashtag.value != blank -%}
            <span class="ebels-rl__hashtag">{{ product.metafields.custom.real_looks_hashtag.value }}</span>
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>

    <div class="ebels-rl__grid">
      {%- for post in real_looks_posts -%}
        {%- assign post_link = post.link_url.value -%}
        {%- if post_link != blank -%}
          <a href="{{ post_link }}" class="ebels-rl__post" target="_blank" rel="noopener" data-reveal>
        {%- else -%}
          <div class="ebels-rl__post" data-reveal>
        {%- endif -%}

          <div class="ebels-rl__media">
            {%- if post.image.value != blank -%}
              {{ post.image.value | image_url: width: 500 | image_tag: loading: 'lazy', class: 'ebels-rl__img', widths: '250, 375, 500' }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'ebels-rl__img' }}
            {%- endif -%}
          </div>
          {%- if post.instagram_handle.value != blank -%}
            <p class="ebels-rl__handle">{{ post.instagram_handle.value }}</p>
          {%- endif -%}

        {%- if post_link != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Ebels Real Looks",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real People, Real Looks" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "See how our community wears this look. Tag us" }
  ],
  "presets": [{ "name": "Ebels Real Looks" }]
}
{% endschema %}
