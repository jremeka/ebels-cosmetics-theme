{{ 'ebels-real-looks.css' | asset_url | stylesheet_tag }}

<div class="ebels-rl page-width" data-real-looks-section>
  <div class="ebels-rl__header" data-reveal>
    {%- if section.settings.heading != blank -%}
      <h2 class="ebels-h2 ebels-rl__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="ebels-rl__subrow">
      {%- if section.settings.subheading != blank -%}
        <p class="ebels-body ebels-rl__subheading">
          {{ section.settings.subheading }}
          {%- if section.settings.hashtag != blank -%}
            <button type="button" class="ebels-rl__hashtag-btn" data-copy-hashtag="{{ section.settings.hashtag }}" aria-label="Copy hashtag {{ section.settings.hashtag }}">
              <span data-copy-label>{{ section.settings.hashtag }}</span>
            </button>
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="ebels-rl__track">
      {%- for block in section.blocks -%}
        {%- capture post_content -%}
          <div class="ebels-rl__media">
            {%- if block.settings.media_type == 'video' and block.settings.video != blank -%}
              {{ block.settings.video | video_tag: image_size: '600x', loop: true, muted: true, autoplay: true, controls: false, playsinline: true, class: 'ebels-rl__video' }}
              <div class="ebels-rl__controls">
                <button type="button" class="ebels-rl__mute" aria-label="Unmute video">
                  <svg class="ebels-rl__mute-off" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
                  <svg class="ebels-rl__mute-on" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
                </button>
                <button type="button" class="ebels-rl__play" aria-label="Pause video">
                  <svg class="ebels-rl__icon-play" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                  <svg class="ebels-rl__icon-pause" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
                </button>
              </div>
            {%- elsif block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', class: 'ebels-rl__img', alt: block.settings.alt_text, widths: '250, 375, 500' }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'ebels-rl__img' }}
            {%- endif -%}

            {%- if block.settings.handle != blank -%}
              <span class="ebels-rl__handle">
                <span class="ebels-rl__handle-dot" aria-hidden="true"></span>
                {{ block.settings.handle }}
              </span>
            {%- endif -%}
          </div>
        {%- endcapture -%}

        <div class="ebels-rl__card" data-reveal {{ block.shopify_attributes }}>
          {%- if block.settings.link_url != blank -%}
            <a href="{{ block.settings.link_url }}" class="ebels-rl__card-link" target="_blank" rel="noopener" aria-label="View post by {{ block.settings.handle | default: 'customer' }}">
              {{ post_content }}
            </a>
          {%- else -%}
            {{ post_content }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

<script src="{{ 'ebels-real-looks.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Real People, Real Looks",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real People, Real Looks"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "See how our community wears this look. Tag us"
    },
    {
      "type": "text",
      "id": "hashtag",
      "label": "Hashtag",
      "default": "#EBELSvelvetrouge",
      "info": "Shown after the subheading, and copyable via the button next to it."
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "label": "Media type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Used when media type is Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Used when media type is Video. Square/vertical clips look best."
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Image alt text",
          "info": "Describe the image for accessibility and SEO"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Customer handle",
          "default": "@lipqueen"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link to original post (optional)"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Ebels Real People, Real Looks",
      "blocks": [
        { "type": "post", "settings": { "handle": "@lipqueen" } },
        { "type": "post", "settings": { "handle": "@beautybyamira" } },
        { "type": "post", "settings": { "handle": "@glowsglows" } },
        { "type": "post", "settings": { "handle": "@stylebymaya" } },
        { "type": "post", "settings": { "handle": "@rosiebeauty" } }
      ]
    }
  ]
}
{% endschema %}
