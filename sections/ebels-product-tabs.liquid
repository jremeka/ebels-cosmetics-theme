{{ 'ebels-product-tabs.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  EBELS PRODUCT TABS
  Each tab block can pull REAL per-product content two ways instead of
  showing the same static text on every product:
  1. use_product_description — pulls product.description directly
     (Description tab). No setup needed — every product already has this.
  2. use_metafield + metafield_key — pulls product.metafields.<key>
     (Ingredients / How to Use / Shipping & Returns tabs). Requires
     creating the metafield definition once in Admin, then filling it in
     per product. See the schema audit doc for exact definitions to create.
  If neither is checked, falls back to the static heading/body typed
  directly into the block — useful for content that's genuinely the same
  across every product (rare, but the option stays available).
{%- endcomment -%}

<div class="ebels-tabs page-width" data-tabs-section>

  {%- if section.blocks.size > 0 -%}
    <div class="ebels-tabs__nav" role="tablist" aria-label="Product information">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="ebels-tabs__tab{% if forloop.first %} is-active{% endif %}"
          role="tab"
          id="ebels-tab-{{ block.id }}"
          aria-controls="ebels-panel-{{ block.id }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          data-tab-trigger
          data-tab-index="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.label | default: 'Tab' }}
        </button>
      {%- endfor -%}
    </div>

    <div class="ebels-tabs__panels">
      {%- for block in section.blocks -%}
        {%- liquid
          assign checklist_items = block.settings.checklist_items | newline_to_br | split: '<br />'

          assign tab_body = block.settings.body
          assign tab_heading = block.settings.heading

          if block.settings.use_product_description
            assign tab_body = product.description
          elsif block.settings.use_metafield and block.settings.metafield_key != blank
            assign mf_parts = block.settings.metafield_key | split: '.'
            assign tab_body = product.metafields[mf_parts[0]][mf_parts[1]].value
          endif
        -%}
        <div
          class="ebels-tabs__panel{% if forloop.first %} is-active{% endif %}"
          role="tabpanel"
          id="ebels-panel-{{ block.id }}"
          aria-labelledby="ebels-tab-{{ block.id }}"
          data-tab-panel
          data-tab-index="{{ forloop.index0 }}"
          {% unless forloop.first %}hidden{% endunless %}
        >
          <div class="ebels-tabs__panel-grid">
            <div class="ebels-tabs__panel-text">
              {%- if tab_heading != blank -%}
                <h2 class="ebels-h3">{{ tab_heading }}</h2>
              {%- endif -%}
              {%- if tab_body != blank -%}
                <div class="ebels-body ebels-tabs__body">{{ tab_body }}</div>
              {%- else -%}
                <p class="ebels-body ebels-tabs__empty">No {{ block.settings.label | downcase }} information added for this product yet.</p>
              {%- endif -%}
            </div>

            {%- if block.settings.checklist_items != blank -%}
              <ul class="ebels-tabs__checklist">
                {%- for item in checklist_items -%}
                  {%- assign trimmed_item = item | strip -%}
                  {%- if trimmed_item != blank -%}
                    <li class="ebels-tabs__checklist-item">
                      <svg class="ebels-tabs__check-icon" width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <path d="M13.5 4.5L6.5 11.5L2.5 7.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      <span class="ebels-body-sm">{{ trimmed_item }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

<script src="{{ 'ebels-product-tabs.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Ebels Product Tabs",
  "settings": [],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab label",
          "default": "Description"
        },
        {
          "type": "checkbox",
          "id": "use_product_description",
          "label": "Use this product's real Description field",
          "info": "Pulls from the product's own Description in Admin — correct automatically for every product, no extra setup. Recommended for the Description tab.",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "use_metafield",
          "label": "Use a product metafield instead",
          "info": "For content that's genuinely per-product but isn't the Description field — e.g. Ingredients, How to Use. Requires creating the metafield definition once in Admin first.",
          "default": false
        },
        {
          "type": "text",
          "id": "metafield_key",
          "label": "Metafield key",
          "info": "Format: namespace.key — e.g. custom.ingredients — must exactly match a metafield definition in Admin > Settings > Custom data > Products"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading (optional, used only if neither option above is checked)"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body text (used only if neither option above is checked)"
        },
        {
          "type": "textarea",
          "id": "checklist_items",
          "label": "Checklist items (optional)",
          "info": "One item per line. Same on every product — fine for generic claims, but shows identically everywhere."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ebels Product Tabs",
      "blocks": [
        {
          "type": "tab",
          "settings": { "label": "Description", "use_product_description": true }
        },
        {
          "type": "tab",
          "settings": { "label": "Ingredients", "use_metafield": true, "metafield_key": "custom.ingredients" }
        },
        {
          "type": "tab",
          "settings": { "label": "How to Use", "use_metafield": true, "metafield_key": "custom.how_to_use" }
        },
        {
          "type": "tab",
          "settings": { "label": "Shipping & Returns" }
        }
      ]
    }
  ]
}
{% endschema %}
