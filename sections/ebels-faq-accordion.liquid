{{ 'ebels-faq-accordion.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Groups blocks by their "category" setting, preserving first-seen order.
  Liquid's group_by filter doesn't play nicely with block.settings paths,
  so this builds the category list manually instead (see hard-learned bug
  pattern #8: no piping filters directly inside a for-loop expression).
{%- endcomment -%}
{%- liquid
  assign category_string = ''
  for block in section.blocks
    assign cat = block.settings.category
    unless category_string contains cat
      assign category_string = category_string | append: cat | append: '||'
    endunless
  endfor
  assign category_list = category_string | split: '||'
-%}

<div class="ebels-faq-accordion page-width" data-reveal>
  {%- for category in category_list -%}
    <div class="ebels-faq-accordion__group" data-category="{{ category | escape }}">
      <h2 class="ebels-faq-accordion__category">{{ category }}</h2>
      {%- for block in section.blocks -%}
        {%- if block.settings.category == category -%}
          <details class="ebels-faq-item" {{ block.shopify_attributes }}>
            <summary class="ebels-faq-item__question">
              {{ block.settings.question }}
              <span class="ebels-faq-item__icon" aria-hidden="true"></span>
            </summary>
            <div class="ebels-faq-item__answer">{{ block.settings.answer }}</div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endfor -%}

  <p class="ebels-faq-accordion__empty" data-faq-empty hidden>No results found. Try a different search term.</p>
</div>

<script src="{{ 'ebels-faq.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Ebels FAQ Accordion",
  "settings": [
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 60, "step": 4, "unit": "px", "label": "Padding top", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 60, "step": 4, "unit": "px", "label": "Padding bottom", "default": 24 }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "category",
          "label": "Category",
          "info": "Must exactly match a pill in the FAQ Header section above",
          "default": "Shipping"
        },
        { "type": "text", "id": "question", "label": "Question", "default": "How long does delivery take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Standard delivery takes 3-5 business days.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ebels FAQ Accordion",
      "blocks": [
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
