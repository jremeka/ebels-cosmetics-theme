{% comment %}
  EBELS OFFERS STRIP
  Slim full-width strip with 2–3 side-by-side offers.
  Each offer: icon, bold line, supporting line, optional text link.
{% endcomment %}

<div class="ebels-offers" style="background: {{ section.settings.background }};">
  <div class="ebels-offers__inner">
    {% for block in section.blocks %}
      <div class="ebels-offers__item" {{ block.shopify_attributes }}>
        {% if block.settings.icon != 'none' %}
          <span class="ebels-offers__icon">
            {% case block.settings.icon %}
              {% when 'tag' %}
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
              {% when 'truck' %}
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              {% when 'gift' %}
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5" rx="1"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
              {% when 'sparkle' %}
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.9 5.8a2 2 0 0 0 1.3 1.3L21 12l-5.8 1.9a2 2 0 0 0-1.3 1.3L12 21l-1.9-5.8a2 2 0 0 0-1.3-1.3L3 12l5.8-1.9a2 2 0 0 0 1.3-1.3L12 3z"/></svg>
            {% endcase %}
          </span>
        {% endif %}
        <div class="ebels-offers__copy">
          {% if block.settings.title != blank %}
            <p class="ebels-offers__title">{{ block.settings.title }}</p>
          {% endif %}
          {% if block.settings.text != blank %}
            <p class="ebels-offers__text">{{ block.settings.text }}</p>
          {% endif %}
          {% if block.settings.link_label != blank %}
            <a href="{{ block.settings.link | default: '#' }}" class="ebels-offers__link">{{ block.settings.link_label }} →</a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% style %}
  .ebels-offers {
    max-width: 1440px;
    margin: var(--space-8) auto;
    padding: 0 var(--space-4);
    background: transparent !important;
  }

  .ebels-offers__inner {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_most: 3 | at_least: 1 }}, 1fr);
    background: {{ section.settings.background }};
    border-radius: var(--radius-lg);
    padding: var(--space-8) var(--space-6);
  }

  .ebels-offers__item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding: 0 var(--space-6);
    text-align: center;
  }

  .ebels-offers__item:not(:first-child) {
    border-left: 1px solid rgba(255, 255, 255, 0.2);
  }

  .ebels-offers__icon {
    color: rgba(255, 255, 255, 0.85);
    flex-shrink: 0;
  }

  .ebels-offers__title {
    font-family: var(--font-body);
    font-size: var(--text-body-size);
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: #FFFFFF;
    margin: 0 0 var(--space-1);
  }

  .ebels-offers__text {
    font-family: var(--font-body);
    font-size: var(--text-body-sm-size);
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
  }

  .ebels-offers__link {
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--text-body-sm-size);
    font-weight: 500;
    color: var(--ebels-amber);
    text-decoration: none;
    margin-top: var(--space-1);
  }

  .ebels-offers__link:hover {
    text-decoration: underline;
  }

  @media screen and (max-width: 749px) {
    .ebels-offers__inner {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding: var(--space-6) var(--space-4);
    }

    .ebels-offers__item:not(:first-child) {
      border-left: none;
      border-top: 1px solid rgba(255, 255, 255, 0.2);
      padding-top: var(--space-6);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Ebels Offers Strip",
  "tag": "section",
  "class": "section-ebels-offers",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Strip background",
      "default": "#7D1F3D"
    }
  ],
  "blocks": [
    {
      "type": "offer",
      "name": "Offer",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "tag", "label": "Sale tag" },
            { "value": "truck", "label": "Delivery truck" },
            { "value": "gift", "label": "Gift" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "none", "label": "No icon" }
          ],
          "default": "tag"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Offer title",
          "default": "Up to 50% off"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Supporting text",
          "default": "On selected sets & bundles — while stocks last"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "info": "Example: Shop Now. Leave empty for no link."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Ebels Offers Strip",
      "blocks": [
        { "type": "offer" },
        { "type": "offer", "settings": { "icon": "truck", "title": "Free delivery", "text": "On all orders over $50 — no code needed" } }
      ]
    }
  ]
}
{% endschema %}
