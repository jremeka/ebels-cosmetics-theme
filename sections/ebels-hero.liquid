{% comment %}
  EBELS HERO CAROUSEL
  Custom section — slides managed as blocks in the theme editor.
  Matches Figma homepage hero: badge, Fraunces heading, text, CTA,
  image right with espresso gradient overlay, dot navigation.
{% endcomment %}

<div class="ebels-hero" id="EbelsHero-{{ section.id }}" data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.autoplay_speed | times: 1000 }}">
  <div class="ebels-hero__track">
    {% for block in section.blocks %}
      <div class="ebels-hero__slide{% if forloop.first %} is-active{% endif %}" data-slide-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
        {% if block.settings.image %}
          {% if forloop.first %}
            {% assign img_loading = 'eager' %}
          {% else %}
            {% assign img_loading = 'lazy' %}
          {% endif %}
          <div class="ebels-hero__media">
            {{ block.settings.image | image_url: width: 2000 | image_tag: loading: img_loading, class: 'ebels-hero__img', widths: '750, 1100, 1500, 2000' }}
          </div>
        {% else %}
          <div class="ebels-hero__media ebels-hero__media--placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'ebels-hero__img' }}
          </div>
        {% endif %}
        <div class="ebels-hero__overlay"></div>
        <div class="ebels-hero__content">
          {% if block.settings.badge != blank %}
            <span class="ebels-hero__badge">{{ block.settings.badge }}</span>
          {% endif %}
          {% if block.settings.heading != blank %}
            <h2 class="ebels-hero__heading">{{ block.settings.heading }}</h2>
          {% endif %}
          {% if block.settings.text != blank %}
            <p class="ebels-hero__text">{{ block.settings.text }}</p>
          {% endif %}
          {% if block.settings.button_label != blank %}
            <a href="{{ block.settings.button_link | default: '#' }}" class="ebels-btn ebels-btn--primary ebels-hero__cta">
              {{ block.settings.button_label }}
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>

  {% if section.blocks.size > 1 %}
    <div class="ebels-hero__dots" role="tablist" aria-label="Slides">
      {% for block in section.blocks %}
        <button
          class="ebels-hero__dot{% if forloop.first %} is-active{% endif %}"
          data-dot-index="{{ forloop.index0 }}"
          aria-label="Go to slide {{ forloop.index }}"
        ></button>
      {% endfor %}
    </div>
  {% endif %}
</div>

{% style %}
  .ebels-hero {
    position: relative;
    margin: var(--space-4) auto 0;
    max-width: 1440px;
    padding: 0 var(--space-4);
  }

  .ebels-hero__track {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    min-height: 420px;
  }

  .ebels-hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.6s ease;
    pointer-events: none;
  }

  .ebels-hero__slide.is-active {
    position: relative;
    opacity: 1;
    pointer-events: auto;
  }

  .ebels-hero__media,
  .ebels-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ebels-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg,
      rgba(34, 27, 22, 0.88) 0%,
      rgba(34, 27, 22, 0.65) 35%,
      rgba(34, 27, 22, 0.05) 70%);
  }

  .ebels-hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-height: 420px;
    max-width: 480px;
    padding: var(--space-12) var(--space-12);
  }

  .ebels-hero__badge {
    font-family: var(--font-body);
    font-size: var(--text-caption-size);
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ebels-ink);
    background: var(--ebels-blush);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-4);
  }

  .ebels-hero__heading {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: var(--text-h1-size);
    line-height: var(--text-h1-line);
    letter-spacing: var(--text-h1-tracking);
    color: var(--text-inverse);
    margin: 0 0 var(--space-4);
  }

  .ebels-hero__text {
    font-family: var(--font-body);
    font-size: var(--text-body-size);
    line-height: var(--text-body-line);
    color: rgba(255, 251, 247, 0.85);
    margin: 0 0 var(--space-6);
  }

  .ebels-hero__dots {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-4) 0 0;
  }

  .ebels-hero__dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    border: none;
    background: var(--ebels-blush);
    cursor: pointer;
    padding: 0;
    transition: background 0.2s ease, width 0.2s ease;
  }

  .ebels-hero__dot.is-active {
    background: var(--ebels-flame);
    width: 20px;
  }

  @media screen and (max-width: 749px) {
    .ebels-hero__track { min-height: 480px; }
    .ebels-hero__content {
      min-height: 480px;
      max-width: 100%;
      padding: var(--space-8) var(--space-6);
      justify-content: flex-end;
    }
    .ebels-hero__overlay {
      background: linear-gradient(180deg,
        rgba(34, 27, 22, 0.1) 0%,
        rgba(34, 27, 22, 0.85) 70%);
    }
  }
{% endstyle %}

<script>
  (function () {
    function initHero(root) {
      var slides = root.querySelectorAll('.ebels-hero__slide');
      var dots = root.querySelectorAll('.ebels-hero__dot');
      if (slides.length < 2) return;

      var current = 0;
      var timer = null;
      var autoplay = root.dataset.autoplay === 'true';
      var speed = parseInt(root.dataset.speed, 10) || 6000;

      function goTo(index) {
        slides[current].classList.remove('is-active');
        if (dots[current]) dots[current].classList.remove('is-active');
        current = (index + slides.length) % slides.length;
        slides[current].classList.add('is-active');
        if (dots[current]) dots[current].classList.add('is-active');
      }

      function startAutoplay() {
        if (!autoplay) return;
        stopAutoplay();
        timer = setInterval(function () { goTo(current + 1); }, speed);
      }

      function stopAutoplay() {
        if (timer) clearInterval(timer);
      }

      dots.forEach(function (dot) {
        dot.addEventListener('click', function () {
          goTo(parseInt(dot.dataset.dotIndex, 10));
          startAutoplay();
        });
      });

      root.addEventListener('mouseenter', stopAutoplay);
      root.addEventListener('mouseleave', startAutoplay);

      startAutoplay();
    }

    document.querySelectorAll('.ebels-hero').forEach(initHero);

    document.addEventListener('shopify:section:load', function (event) {
      var hero = event.target.querySelector('.ebels-hero');
      if (hero) initHero(hero);
    });
  })();
</script>

{% schema %}
{
  "name": "Ebels Hero",
  "tag": "section",
  "class": "section-ebels-hero",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Seconds per slide",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge text",
          "default": "New Arrival"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Summer Glow Collection"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Discover our curated selection of sun-kissed essentials for the perfect summer look."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Ebels Hero",
      "blocks": [
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
