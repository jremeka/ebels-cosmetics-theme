{{ 'ebels-how-to-wear.css' | asset_url | stylesheet_tag }}

<div class="ebels-htw page-width">
  <div class="ebels-htw__header" data-reveal>
    {%- if section.settings.heading != blank -%}
      <h2 class="ebels-h2 ebels-htw__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="ebels-body ebels-htw__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="ebels-htw__grid">
      {%- for block in section.blocks -%}
        <div class="ebels-htw__step" data-reveal {{ block.shopify_attributes }}>
          <div class="ebels-htw__image">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'ebels-htw__img', widths: '400, 600, 800' }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'ebels-htw__img' }}
            {%- endif -%}
          </div>
          <p class="ebels-label ebels-htw__step-label">Step {{ forloop.index }}</p>
          {%- if block.settings.title != blank -%}
            <h3 class="ebels-h5 ebels-htw__step-title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <p class="ebels-body-sm ebels-htw__step-description">{{ block.settings.description }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Ebels How to Wear",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How to Wear"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Get the perfect pout in 3 simple steps"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step title",
          "default": "Prep & Prime"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Step description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ebels How to Wear",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Prep & Prime",
            "description": "Exfoliate gently with a sugar scrub and apply a light lip balm."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Line & Define",
            "description": "Trace the natural contour of your lips with a matching liner."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Apply & Blot",
            "description": "Glide Velvet Rouge across lips. Blot with a tissue for a soft focus effect."
          }
        }
      ]
    }
  ]
}
{% endschema %}
