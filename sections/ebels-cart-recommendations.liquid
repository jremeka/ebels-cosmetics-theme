{{ 'ebels-cart-recommendations.css' | asset_url | stylesheet_tag }}

<div class="ebels-crec page-width" data-cart-recommendations>
  <script type="application/json" data-money-format>{{ shop.money_format | json }}</script>

  <div class="ebels-crec__header" data-reveal>
    {%- if section.settings.eyebrow != blank -%}
      <p class="ebels-crec__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="ebels-h2 ebels-crec__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="ebels-crec__grid">
      {%- for block in section.blocks -%}
        {%- assign rec_product = block.settings.product -%}
        {%- if rec_product != blank -%}
          {%- assign rec_variant = rec_product.selected_or_first_available_variant -%}
          <div class="ebels-crec__card" data-reveal {{ block.shopify_attributes }}>
            {%- if block.settings.badge_text != blank -%}
              <span class="ebels-crec__badge">{{ block.settings.badge_text }}</span>
            {%- endif -%}

            <a href="{{ rec_product.url }}" class="ebels-crec__media-link" aria-label="{{ rec_product.title | escape }}">
              <div class="ebels-crec__media">
                {%- if rec_product.featured_image != blank -%}
                  {{ rec_product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'ebels-crec__img', widths: '300, 450, 600' }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'ebels-crec__img' }}
                {%- endif -%}
              </div>
            </a>

            <div class="ebels-crec__info">
              <div class="ebels-crec__rating" data-review-placeholder>
                <span class="ebels-crec__stars" aria-hidden="true">★★★★★</span>
                <span class="ebels-caption">(120)</span>
              </div>

              <a href="{{ rec_product.url }}" class="ebels-crec__title-link">
                <h3 class="ebels-crec__title">{{ rec_product.title }}</h3>
              </a>
              <p class="ebels-crec__price">{{ rec_variant.price | money }}</p>

              <button
                type="button"
                class="ebels-btn ebels-crec__add-to-bag"
                data-add-to-bag-crec
                data-variant-id="{{ rec_variant.id }}"
                {% unless rec_variant.available %}disabled{% endunless %}
              >
                {%- if rec_variant.available -%}Add to Bag{%- elsif rec_variant.product.tags contains 'Coming Soon' -%}Coming Soon{%- else -%}Sold Out{%- endif -%}
              </button>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

<script src="{{ 'ebels-cart-recommendations.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Cart Recommendations",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Curated For You"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recommended For You"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "badge_text", "label": "Badge (optional)", "info": "e.g. \"Bestseller\"" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "Cart Recommendations" }
  ]
}
{% endschema %}
