{% comment %}
  EBELS UGC STRIP — "See it on Ebels Ladies"
  Phone-shaped cards with customer videos (or images), handle overlay,
  tap-to-play, and a shoppable product chip. Snap-scrolls on mobile.
{% endcomment %}

<div class="ebels-ugc" id="EbelsUgc-{{ section.id }}">
  <div class="ebels-ugc__header page-width">
    {% if section.settings.heading != blank %}
      <h2 class="ebels-ugc__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="ebels-ugc__subheading">{{ section.settings.subheading }}</p>
    {% endif %}
  </div>

  <div class="ebels-ugc__track">
    {% for block in section.blocks %}
      <div class="ebels-ugc__card" {{ block.shopify_attributes }}>
        <div class="ebels-ugc__media">
          {% if block.settings.video != blank %}
            {{ block.settings.video | video_tag: image_size: '600x', loop: true, muted: true, controls: false, playsinline: true, class: 'ebels-ugc__video' }}
            <button class="ebels-ugc__play" aria-label="Play video">
  <svg class="ebels-ugc__icon-play" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M8 5v14l11-7z"/>
  </svg>
  <svg class="ebels-ugc__icon-pause" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M6 5h4v14H6zM14 5h4v14h-4z"/>
  </svg>
</button>
            <button class="ebels-ugc__mute" aria-label="Unmute video">
  <svg class="ebels-ugc__mute-off" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
    <line x1="23" y1="9" x2="17" y2="15"></line>
    <line x1="17" y1="9" x2="23" y2="15"></line>
  </svg>
  <svg class="ebels-ugc__mute-on" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
    <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
  </svg>
</button>
          {% elsif block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'ebels-ugc__img', widths: '300, 450, 600' }}
          {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'ebels-ugc__img' }}
          {% endif %}

          {% if block.settings.handle != blank %}
            <span class="ebels-ugc__handle">{{ block.settings.handle }}</span>
          {% endif %}

          {% if block.settings.product != blank %}
            <a href="{{ block.settings.product.url }}" class="ebels-ugc__chip">
              {% if block.settings.product.featured_image %}
                {{ block.settings.product.featured_image | image_url: width: 80 | image_tag: loading: 'lazy', class: 'ebels-ugc__chip-img' }}
              {% endif %}
              <span class="ebels-ugc__chip-title">{{ block.settings.product.title }}</span>
              <span class="ebels-ugc__chip-plus" aria-hidden="true">+</span>
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% style %}
  .ebels-ugc {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .ebels-ugc__header {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .ebels-ugc__heading {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: var(--text-h2-size);
    line-height: var(--text-h2-line);
    letter-spacing: var(--text-h2-tracking);
    color: var(--text-primary);
    margin: 0 0 var(--space-3);
  }

  .ebels-ugc__subheading {
    font-family: var(--font-body);
    font-size: var(--text-body-size);
    color: var(--text-secondary);
    margin: 0;
  }

  .ebels-ugc__track {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: var(--space-4);
  max-width: 1440px;
  margin: 0 auto;
  padding: 0 var(--space-4);
}

  .ebels-ugc__card {
    position: relative;
  }

  .ebels-ugc__media {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--ebels-espresso);
  }

  .ebels-ugc__video,
  .ebels-ugc__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ebels-ugc__handle {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    color: #FFFFFF;
    background: rgba(34, 27, 22, 0.55);
    backdrop-filter: blur(4px);
    padding: 3px 10px;
    border-radius: var(--radius-full);
    z-index: 2;
  }

  .ebels-ugc__play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.35);
  border-radius: var(--radius-full);
  cursor: pointer;
  z-index: 2;
  transition: transform 0.2s ease, opacity 0.3s ease, background 0.2s ease;
}

.ebels-ugc__play:hover {
  background: rgba(255, 255, 255, 0.32);
}

.ebels-ugc__icon-pause { display: none; }
.ebels-ugc__card.is-playing .ebels-ugc__play .ebels-ugc__icon-pause { display: block; }
.ebels-ugc__card.is-playing .ebels-ugc__play .ebels-ugc__icon-play { display: none; }

  .ebels-ugc__play svg { margin-left: 2px; }

  .ebels-ugc__play:hover {
    transform: translate(-50%, -50%) scale(1.08);
  }

  .ebels-ugc__card.is-playing .ebels-ugc__play {
    opacity: 0;
    pointer-events: none;
  }

  .ebels-ugc__card.is-playing:hover .ebels-ugc__play {
    opacity: 1;
    pointer-events: auto;
  }
.ebels-ugc__mute {
  position: absolute;
  top: var(--space-3);
  right: var(--space-3);
  width: 30px;
  height: 30px;
  display: none;
  align-items: center;
  justify-content: center;
  color: var(--ebels-ink);
  background: rgba(255, 255, 255, 0.92);
  border: none;
  border-radius: var(--radius-full);
  cursor: pointer;
  z-index: 2;
}

.ebels-ugc__card.is-playing .ebels-ugc__mute { display: flex; }
.ebels-ugc__mute .ebels-ugc__mute-on { display: none; }
.ebels-ugc__mute.is-unmuted .ebels-ugc__mute-on { display: block; }
.ebels-ugc__mute.is-unmuted .ebels-ugc__mute-off { display: none; }
  .ebels-ugc__chip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: var(--space-2);
  background: rgba(34, 27, 22, 0.3);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  padding: var(--space-3);
  text-decoration: none;
  z-index: 2;
  transition: background 0.2s ease;
}

.ebels-ugc__chip:hover {
  background: rgba(34, 27, 22, 0.45);
}

  .ebels-ugc__chip-img {
    width: 28px;
    height: 28px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .ebels-ugc__chip-title {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    color: #FFFFFF;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
  }

  .ebels-ugc__chip-plus {
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    color: #FFFFFF;
    background: var(--brand-primary);
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }

  @media screen and (max-width: 989px) {
    .ebels-ugc__track {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: var(--space-3);
      padding: 0 var(--space-4) var(--space-2);
    }

    .ebels-ugc__track::-webkit-scrollbar { display: none; }

    .ebels-ugc__card {
      flex: 0 0 46%;
      scroll-snap-align: start;
    }
  }

  @media screen and (max-width: 599px) {
    .ebels-ugc__card { flex: 0 0 62%; }
  }
{% endstyle %}

<script>
  (function () {
    function initUgc(root) {
      var cards = root.querySelectorAll('.ebels-ugc__card');

      function pauseAll(except) {
        cards.forEach(function (card) {
          var video = card.querySelector('video');
          if (video && video !== except && !video.paused) {
            video.pause();
            card.classList.remove('is-playing');
          }
        });
      }

      cards.forEach(function (card) {
        var video = card.querySelector('video');
        var playBtn = card.querySelector('.ebels-ugc__play');
        if (!video || !playBtn) return;
        var muteBtn = card.querySelector('.ebels-ugc__mute');
        if (muteBtn) {
          muteBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            video.muted = !video.muted;
            muteBtn.classList.toggle('is-unmuted', !video.muted);
            muteBtn.setAttribute('aria-label', video.muted ? 'Unmute video' : 'Mute video');
          });
        }

        playBtn.addEventListener('click', function () {
          if (video.paused) {
            pauseAll(video);
            video.play();
            card.classList.add('is-playing');
          } else {
            video.pause();
            card.classList.remove('is-playing');
          }
        });

        video.addEventListener('click', function () {
          if (!video.paused) {
            video.pause();
            card.classList.remove('is-playing');
          }
        });
      });

      // Pause any playing video that scrolls out of view
      if ('IntersectionObserver' in window) {
        var viewObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            var video = entry.target.querySelector('video');
            if (video && !entry.isIntersecting && !video.paused) {
              video.pause();
              entry.target.classList.remove('is-playing');
            }
          });
        }, { threshold: 0.2 });

        cards.forEach(function (card) { viewObserver.observe(card); });
      }
    }

    document.querySelectorAll('.ebels-ugc').forEach(initUgc);

    document.addEventListener('shopify:section:load', function (event) {
      var ugc = event.target.querySelector('.ebels-ugc');
      if (ugc) initUgc(ugc);
    });
  })();
</script>

{% schema %}
{
  "name": "Ebels UGC Strip",
  "tag": "section",
  "class": "section-ebels-ugc",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See it on Ebels Ladies"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real customers, real looks. Tag #EBELSbabes for a chance to be featured."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "UGC card",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Vertical (9:16) videos look best"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (used if no video)"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Customer handle",
          "info": "Example: @sarah.styles"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Featured product",
          "info": "Shows as a shoppable chip on the card"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Ebels UGC Strip",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
