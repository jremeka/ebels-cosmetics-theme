{{ 'ebels-about-stats.css' | asset_url | stylesheet_tag }}

<div class="ebels-about-stats-wrap page-width">
  <div class="ebels-about-stats">
    {%- for block in section.blocks -%}
      <div class="ebels-about-stats__item" data-reveal {{ block.shopify_attributes }}>
        <span class="ebels-about-stats__number">{{ block.settings.number }}</span>
        <span class="ebels-about-stats__label">{{ block.settings.label }}</span>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Ebels About Stats",
  "settings": [
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 60, "step": 4, "unit": "px", "label": "Padding top", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 60, "step": 4, "unit": "px", "label": "Padding bottom", "default": 24 }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "50K+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Happy Customers" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ebels About Stats",
      "blocks": [
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" }
      ]
    }
  ]
}
{% endschema %}
