{{ 'ebels-collections-list-grid.css' | asset_url | stylesheet_tag }}

<div class="ebels-clg page-width">
  <div class="ebels-clg__header" data-reveal>
    {%- if section.settings.heading != blank -%}
      <h2 class="ebels-h2 ebels-clg__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="ebels-body ebels-clg__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="ebels-clg__grid">
      {%- for block in section.blocks -%}
        {%- assign cl_collection = block.settings.collection -%}
        {%- if cl_collection != blank -%}
          {%- assign cl_image = block.settings.custom_image | default: cl_collection.image -%}
          <a href="{{ cl_collection.url }}" class="ebels-clg__card" data-reveal {{ block.shopify_attributes }}>
            <div class="ebels-clg__media">
              {%- if cl_image != blank -%}
                {{ cl_image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'ebels-clg__img', widths: '500, 750, 1000' }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'ebels-clg__img' }}
              {%- endif -%}
              <div class="ebels-clg__overlay"></div>

              <div class="ebels-clg__label">
                <span class="ebels-clg__title">{{ block.settings.custom_title | default: cl_collection.title }}</span>
                <span class="ebels-clg__count">{{ cl_collection.all_products_count }} Products</span>
              </div>

              <span class="ebels-clg__arrow" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                </svg>
              </span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Ebels Collections Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Collection"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore our curated collections"
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom image (optional)",
          "info": "1000 × 700px recommended. Overrides the collection's own image."
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom title (optional)",
          "info": "Overrides the collection's own title if set"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Ebels Collections Grid",
      "blocks": [
        { "type": "collection_item" },
        { "type": "collection_item" },
        { "type": "collection_item" },
        { "type": "collection_item" }
      ]
    }
  ]
}
{% endschema %}
