{{ 'ebels-404-picks.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Hand-picked, not real "most loved" data — Shopify has no native metric
  for that. Same pattern as Complete the Look / other curated sections.
{%- endcomment -%}

<div class="ebels-404p page-width" data-404-picks-section>
  <script type="application/json" data-money-format>{{ shop.money_format | json }}</script>

  <div class="ebels-404p__header" data-reveal>
    {%- if section.settings.heading != blank -%}
      <h2 class="ebels-h2 ebels-404p__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="ebels-body ebels-404p__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="ebels-404p__grid">
      {%- for block in section.blocks -%}
        {%- assign p_product = block.settings.product -%}
        {%- if p_product != blank -%}
          {%- assign p_variant = p_product.selected_or_first_available_variant -%}
          <div class="ebels-404p__card" data-reveal {{ block.shopify_attributes }}>
            <a href="{{ p_product.url }}" class="ebels-404p__media-link">
              <div class="ebels-404p__media">
                {%- if p_product.featured_image != blank -%}
                  {{ p_product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', class: 'ebels-404p__img', widths: '250, 375, 500' }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'ebels-404p__img' }}
                {%- endif -%}
              </div>
            </a>
            <div class="ebels-404p__info">
              <a href="{{ p_product.url }}" class="ebels-404p__title-link">
                <h3 class="ebels-404p__title">{{ p_product.title }}</h3>
              </a>
              {%- if block.settings.subtitle != blank -%}
                <p class="ebels-404p__subtitle">{{ block.settings.subtitle }}</p>
              {%- endif -%}
              <p class="ebels-404p__price">{{ p_variant.price | money }}</p>
              <button
                type="button"
                class="ebels-btn ebels-404p__add-to-bag"
                data-add-to-bag-404p
                data-variant-id="{{ p_variant.id }}"
                {% unless p_variant.available %}disabled{% endunless %}
              >
                {%- if p_variant.available -%}Add to Bag{%- else -%}Sold Out{%- endif -%}
              </button>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

<script src="{{ 'ebels-404-picks.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Ebels 404 Picks",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "While you're here..."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Check out what everyone is loving right now"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "subtitle", "label": "Subtitle (optional)", "info": "e.g. \"Matte finish · 12-hour comfort\"" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "Ebels 404 Picks" }
  ]
}
{% endschema %}
