{{ 'ebels-recently-viewed.css' | asset_url | stylesheet_tag }}

<div
  class="ebels-rv page-width"
  data-recently-viewed-section
  data-current-handle="{{ product.handle }}"
  data-products-to-show="{{ section.settings.products_to_show }}"
  hidden
>
  <script type="application/json" data-money-format>{{ shop.money_format | json }}</script>

  <div class="ebels-rv__header">
    {%- if section.settings.heading != blank -%}
      <h2 class="ebels-h2 ebels-rv__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.view_all_link != blank -%}
      <a href="{{ section.settings.view_all_link }}" class="ebels-rv__view-all">View All</a>
    {%- endif -%}
  </div>

  <div class="ebels-rv__grid" data-rv-grid></div>
</div>

<script src="{{ 'ebels-recently-viewed.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Recently Viewed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently Viewed"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "\"View All\" link",
      "info": "Leave blank to hide the View All link"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Recently Viewed"
    }
  ]
}
{% endschema %}
