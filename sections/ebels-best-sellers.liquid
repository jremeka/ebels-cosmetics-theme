{% comment %}
  EBELS BEST SELLERS
  Editorial product cards: image, name, short description, dark pill CTA.
  Each card can link to a product (auto image/title/link) with manual overrides.
{% endcomment %}

<div class="ebels-bestsellers page-width">
  <div class="ebels-bestsellers__header">
    {% if section.settings.heading != blank %}
      <h2 class="ebels-bestsellers__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="ebels-bestsellers__subheading">{{ section.settings.subheading }}</p>
    {% endif %}
  </div>

  <div class="ebels-bestsellers__grid">
    {% for block in section.blocks %}
      {% liquid
        assign card_product = block.settings.product

        assign card_image = block.settings.image
        if card_image == blank and card_product != blank
          assign card_image = card_product.featured_image
        endif

        assign card_title = block.settings.title
        if card_title == blank and card_product != blank
          assign card_title = card_product.title
        endif

        assign card_url = block.settings.link
        if card_url == blank and card_product != blank
          assign card_url = card_product.url
        endif

        assign card_button = block.settings.button_label
        if card_button == blank
          assign card_button = 'Shop now'
        endif
      %}

      <div class="ebels-bestsellers__card" {{ block.shopify_attributes }}>
        <a href="{{ card_url | default: '#' }}" class="ebels-bestsellers__media-link" tabindex="-1" aria-hidden="true">
          <div class="ebels-bestsellers__media">
            {% if card_image != blank %}
              {{ card_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'ebels-bestsellers__img', widths: '400, 600, 800' }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'ebels-bestsellers__img' }}
            {% endif %}
          </div>
        </a>
        <div class="ebels-bestsellers__info">
          {% if card_title != blank %}
            <h3 class="ebels-bestsellers__title">{{ card_title }}</h3>
          {% endif %}
          {% if block.settings.description != blank %}
            <p class="ebels-bestsellers__desc">{{ block.settings.description }}</p>
          {% endif %}
          <a href="{{ card_url | default: '#' }}" class="ebels-bestsellers__btn">{{ card_button }}</a>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% style %}
  .ebels-bestsellers {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .ebels-bestsellers__header {
    text-align: center;
    max-width: 560px;
    margin: 0 auto var(--space-10);
  }

  .ebels-bestsellers__heading {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: var(--text-h2-size);
    line-height: var(--text-h2-line);
    letter-spacing: var(--text-h2-tracking);
    color: var(--text-primary);
    margin: 0 0 var(--space-3);
  }

  .ebels-bestsellers__subheading {
    font-family: var(--font-body);
    font-size: var(--text-body-size);
    line-height: var(--text-body-line);
    color: var(--text-secondary);
    margin: 0;
  }

  .ebels-bestsellers__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .ebels-bestsellers__card {
    display: flex;
    flex-direction: column;
  }

  .ebels-bestsellers__media-link {
    display: block;
  }

  .ebels-bestsellers__media {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-secondary);
  }

  .ebels-bestsellers__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .ebels-bestsellers__card:hover .ebels-bestsellers__img {
    transform: scale(1.04);
  }

  .ebels-bestsellers__info {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding-top: var(--space-4);
  }

  .ebels-bestsellers__title {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-body-size);
    line-height: var(--text-body-line);
    color: var(--text-primary);
    margin: 0 0 var(--space-2);
  }

  .ebels-bestsellers__desc {
    font-family: var(--font-body);
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-line);
    color: var(--text-secondary);
    margin: 0 0 var(--space-4);
  }

  .ebels-bestsellers__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: auto;
    font-family: var(--font-body);
    font-size: var(--text-caption-size);
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-inverse);
    background: var(--ebels-ink);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-full);
    transition: background 0.2s ease;
  }

  .ebels-bestsellers__btn:hover {
    background: var(--ebels-espresso);
    color: var(--text-inverse);
  }

  @media screen and (max-width: 989px) {
    .ebels-bestsellers__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 599px) {
    .ebels-bestsellers {
      padding-top: var(--space-12);
      padding-bottom: var(--space-12);
    }
    .ebels-bestsellers__grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Ebels Best Sellers",
  "tag": "section",
  "class": "section-ebels-bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ebels best sellers"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Browse through our collection of most-loved and top-rated essentials."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Product card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Fills the image, title, and link automatically. The fields below override it."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image (optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title (optional)"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Short description"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "info": "Example: Shop Chelsea Tote"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link (optional)"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Ebels Best Sellers",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
