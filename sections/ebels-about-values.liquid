{{ 'ebels-about-values.css' | asset_url | stylesheet_tag }}

<div class="ebels-about-values page-width">
  {%- if section.settings.title != blank -%}
    <h2 class="ebels-about-values__title" data-reveal>{{ section.settings.title }}</h2>
  {%- endif -%}

  <div class="ebels-about-values__grid">
    {%- for block in section.blocks -%}
      <div class="ebels-about-values__card" data-reveal {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}
          <span class="ebels-about-values__icon" aria-hidden="true">{{ block.settings.icon }}</span>
        {%- endif -%}
        <h3 class="ebels-about-values__card-title">{{ block.settings.title }}</h3>
        <p class="ebels-about-values__card-text">{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Ebels About Values",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "What We Stand For" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 60 }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji or symbol)", "default": "\u2726" },
        { "type": "text", "id": "title", "label": "Title", "default": "Conscious Beauty" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "We prioritize clean ingredients and sustainable packaging." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ebels About Values",
      "blocks": [
        { "type": "value" },
        { "type": "value" },
        { "type": "value" }
      ]
    }
  ]
}
{% endschema %}
