{{ 'ebels-newsletter.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  EBELS NEWSLETTER
  Dark editorial email-capture banner. Uses Shopify's native customer form
  (contact[tags]=newsletter) — real signups, no app needed.
{%- endcomment -%}

<div class="ebels-nl" style="background: {{ section.settings.background }};">
  <div class="ebels-nl__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="ebels-nl__eyebrow">✦ {{ section.settings.eyebrow }} ✦</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="ebels-nl__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="ebels-nl__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {% form 'customer', class: 'ebels-nl__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="ebels-nl__field-row">
        <label class="visually-hidden" for="EbelsNewsletter-{{ section.id }}">Email</label>
        <input
          id="EbelsNewsletter-{{ section.id }}"
          type="email"
          name="contact[email]"
          class="ebels-nl__input"
          value="{{ form.email }}"
          placeholder="Enter your email"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          required
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="EbelsNewsletter-error-{{ section.id }}"
          {% endif %}
        >
        <button type="submit" class="ebels-btn ebels-btn--primary ebels-nl__submit">
          {{ section.settings.button_label }}
        </button>
      </div>

      {%- if form.errors -%}
        <small class="ebels-nl__message ebels-nl__message--error" id="EbelsNewsletter-error-{{ section.id }}">
          {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
        </small>
      {%- endif -%}
      {%- if form.posted_successfully? -%}
        <small class="ebels-nl__message ebels-nl__message--success">
          Thanks for subscribing!
        </small>
      {%- endif -%}
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Ebels Newsletter",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#221B16"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Join the Inner Circle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Be the First to Know"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "New drops, exclusive offers, and beauty tips — delivered straight to your inbox."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "Ebels Newsletter"
    }
  ]
}
{% endschema %}
