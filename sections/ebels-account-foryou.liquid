{{ 'ebels-account-foryou.css' | asset_url | stylesheet_tag }}

{%- if customer or request.design_mode -%}
<div class="ebels-acc-fy page-width" data-account-tab-panel="foryou" hidden>

  {%- comment -%}
    PICKED FOR YOU — hand-picked, not real personalization. Shopify has no
    native purchase-history-based recommendation engine for theme use;
    building genuine per-customer personalization needs a dedicated app.
    This mirrors the same product-picker pattern as Complete the Look.
  {%- endcomment -%}
  {%- if section.blocks.size > 0 -%}
    <div class="ebels-acc-fy__section">
      <h2 class="ebels-acc-fy__section-title">Picked For You</h2>
      <p class="ebels-caption ebels-acc-fy__section-sub">Hand-picked favorites we think you'll love</p>

      <div class="ebels-acc-fy__grid">
        {%- for block in section.blocks -%}
          {%- assign fy_product = block.settings.product -%}
          {%- if fy_product != blank -%}
            {%- assign fy_variant = fy_product.selected_or_first_available_variant -%}
            <div class="ebels-acc-fy__card" {{ block.shopify_attributes }}>
              <a href="{{ fy_product.url }}" class="ebels-acc-fy__media-link">
                <div class="ebels-acc-fy__media">
                  {%- if fy_product.tags contains 'Coming Soon' -%}
                    <span class="ebels-acc-fy__badge">Coming Soon</span>
                  {%- endif -%}
                  {%- if fy_product.featured_image != blank -%}
                    {{ fy_product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', class: 'ebels-acc-fy__img', widths: '250, 375, 500' }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'ebels-acc-fy__img' }}
                  {%- endif -%}
                </div>
              </a>
              <div class="ebels-acc-fy__info">
                <a href="{{ fy_product.url }}" class="ebels-acc-fy__title-link">
                  <h3 class="ebels-acc-fy__title">{{ fy_product.title }}</h3>
                </a>
                <p class="ebels-acc-fy__price">{{ fy_variant.price | money }}</p>
                <button
                  type="button"
                  class="ebels-btn ebels-acc-fy__add-to-bag"
                  data-add-to-bag-fy
                  data-variant-id="{{ fy_variant.id }}"
                  {% unless fy_variant.available %}disabled{% endunless %}
                >
                  {%- if fy_variant.available -%}Add to Bag{%- elsif fy_product.tags contains 'Coming Soon' -%}Coming Soon{%- else -%}Sold Out{%- endif -%}
                </button>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>
{%- endif -%}

<script src="{{ 'ebels-account-foryou.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Ebels Account For You",
  "settings": [],
  "blocks": [
    {
      "type": "product",
      "name": "Picked product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "Ebels Account For You" }
  ]
}
{% endschema %}
