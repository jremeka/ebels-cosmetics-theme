          "settings": {
            "category": "Returns & Exchanges",
            "question": "How long do refunds take?",
            "answer": "<p>Once we receive your returned item, refunds are processed within 3-5 business days. The refund will be issued to your original payment method. Please allow an additional 2-3 days for the amount to appear in your account depending on your bank.</p>"
          }
