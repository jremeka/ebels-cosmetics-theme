          "type": "faq",
          "settings": {
            "category": "Returns & Exchanges",
            "question": "What is your return policy?",
            "answer": "<p>We offer a 30-day return policy on all unused and unopened products. Items must be in their original packaging with all seals intact. Sale items can be returned within 14 days. Simply initiate a return through your account or contact our support team.</p>"
          }
        },
        "faq_ggKQmt": {
          "type": "faq",
          "settings": {
            "category": "Returns & Exchanges",
            "question": "How do I start a return?",
            "answer": "<p>Log into your account and navigate to 'My Orders'. Select the order containing the item you'd like to return, click 'Request Return', and follow the prompts. You'll receive a prepaid return label via email within 24 hours.</p>"
          }
        },
        "faq_WgTicp": {
          "type": "faq",
          "settings": {
