{% doc %}
  @prompt
    Can we generate the password input for when the website is restricted and dev has to put a password, the form seems to be broken. it just shows a error in what seems to be code
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-password-input-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-password-input-container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    text-align: center;
  }

  .ai-password-input-logo-{{ ai_gen_id }} {
    margin-bottom: 24px;
  }

  .ai-password-input-logo-{{ ai_gen_id }} img {
    max-width: {{ block.settings.logo_width }}px;
    height: auto;
  }

  .ai-password-input-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px;
    font-weight: 600;
  }

  .ai-password-input-message-{{ ai_gen_id }} {
    font-size: {{ block.settings.message_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 32px;
    opacity: 0.8;
  }

  .ai-password-input-form-wrapper-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.form_max_width }}px;
  }

  .ai-password-input-field-wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
  }

  .ai-password-input-field-{{ ai_gen_id }} {
    flex: 1;
    padding: 14px 16px;
    font-size: 16px;
    border: {{ block.settings.input_border_thickness }}px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.input_text_color }};
  }

  .ai-password-input-field-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.button_color }};
    outline-offset: 2px;
  }

  .ai-password-input-field-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.input_text_color }};
    opacity: 0.5;
  }

  .ai-password-input-button-{{ ai_gen_id }} {
    padding: 14px 32px;
    font-size: 16px;
    font-weight: 600;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-password-input-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-password-input-error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
    font-size: 14px;
    margin-top: 8px;
    text-align: left;
  }

  .ai-password-input-footer-{{ ai_gen_id }} {
    margin-top: 24px;
    font-size: 14px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
  }

  .ai-password-input-footer-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  @media screen and (max-width: 749px) {
    .ai-password-input-container-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.7 }}px;
    }

    .ai-password-input-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-password-input-message-{{ ai_gen_id }} {
      font-size: {{ block.settings.message_size | times: 0.9 }}px;
    }

    .ai-password-input-field-wrapper-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-password-input-button-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<password-input-{{ ai_gen_id }}
  class="ai-password-input-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-password-input-container-{{ ai_gen_id }}">
    {% if block.settings.show_logo and block.settings.logo %}
      <div class="ai-password-input-logo-{{ ai_gen_id }}">
        <img
          src="{{ block.settings.logo | image_url: width: 600 }}"
          alt="{{ shop.name }}"
          width="{{ block.settings.logo_width }}"
          height="auto"
          loading="lazy"
        >
      </div>
    {% endif %}

    {% if block.settings.heading != blank %}
      <h1 class="ai-password-input-heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h1>
    {% endif %}

    {% if block.settings.message != blank %}
      <p class="ai-password-input-message-{{ ai_gen_id }}">
        {{ block.settings.message }}
      </p>
    {% endif %}

    <div class="ai-password-input-form-wrapper-{{ ai_gen_id }}">
      {% form 'storefront_password' %}
        <div class="ai-password-input-field-wrapper-{{ ai_gen_id }}">
          <input
            type="password"
            name="password"
            class="ai-password-input-field-{{ ai_gen_id }}"
            placeholder="{{ block.settings.input_placeholder }}"
            aria-label="Password"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="ai-password-input-error-{{ ai_gen_id }}"
            {% endif %}
            required
            autofocus
          >
          <button
            type="submit"
            class="ai-password-input-button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_text }}
          </button>
        </div>

        {% if form.errors %}
          <div
            id="ai-password-input-error-{{ ai_gen_id }}"
            class="ai-password-input-error-{{ ai_gen_id }}"
          >
            {{ form.errors | default_errors }}
          </div>
        {% endif %}
      {% endform %}
    </div>

    {% if block.settings.show_footer_text and block.settings.footer_text != blank %}
      <div class="ai-password-input-footer-{{ ai_gen_id }}">
        {{ block.settings.footer_text }}
      </div>
    {% endif %}
  </div>
</password-input-{{ ai_gen_id }}>

<script>
  (function() {
    class PasswordInput{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const input = this.querySelector('.ai-password-input-field-{{ ai_gen_id }}');
        
        if (input) {
          input.focus();
        }
      }
    }

    customElements.define('password-input-{{ ai_gen_id }}', PasswordInput{{ ai_gen_id }});
  })();
</script>

